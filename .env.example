# Redis 连接
QWSQ_REDIS_URL=redis://localhost:6379/0
QWSQ_REDIS_KEY_PREFIX=qwsmoothq

# PostgreSQL 统计库；留空则使用内存统计（重启丢失，仅适合本地试玩/测试）
QWSQ_DATABASE_URL=postgresql://qwsmoothq:qwsmoothq@localhost:5432/qwsmoothq

# 下游 HTTP 调用
QWSQ_HTTP_TIMEOUT=10.0

# 均速器速率上下限（单位：请求/秒）
QWSQ_INITIAL_RATE=5
QWSQ_MIN_RATE=0.5
QWSQ_MAX_RATE=20
QWSQ_GLOBAL_MAX_RATE=50

# 自适应调速
QWSQ_BACKLOG_THRESHOLD=20
QWSQ_RATE_INCREASE_PCT=0.2
QWSQ_RATE_DECREASE_PCT=0.5
QWSQ_RECOVERY_INCREASE_PCT=0.05
QWSQ_SUCCESS_STREAK_NEEDED=10
QWSQ_LIMIT_CORRELATION_WINDOW=10
QWSQ_LIMIT_CORRELATION_MIN_APIS=2

# 退避重试（秒）：backoff_base * backoff_factor^(attempt-1)，再加 ±jitter 抖动
QWSQ_BACKOFF_BASE=0.5
QWSQ_BACKOFF_FACTOR=2.0
QWSQ_BACKOFF_MAX=30.0
QWSQ_BACKOFF_JITTER=0.25

# 限流判定规则：内置 http429 / wecom，也可填 "模块路径:类名" 插入自定义规则
QWSQ_LIMIT_RULES=["http429", "wecom"]
QWSQ_WECOM_LIMIT_ERRCODES=[45009, 45011]
QWSQ_WECOM_BUSY_ERRCODES=[-1]

# 消息状态记录保留时长（小时）
QWSQ_STATUS_TTL_HOURS=72
